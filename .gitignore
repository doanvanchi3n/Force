# Obsidian: keep shared settings, ignore each person's layout and cache.
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/
.trash/

# Machine-specific files and credentials.
.DS_Store
Thumbs.db
*~
*.swp
.env
.env.*
!.env.example
.aws/
.codex/
.agents/
node_modules/
__pycache__/

# Local source checkouts, backups, and temporary machine state.
/.tools/
/.local/
.obsidian/.obsidian/

# BMAD personal configuration and rendered workflow snapshots.
/_bmad/config.user.toml
/_bmad/custom/config.user.toml
/_bmad/render/*
!/_bmad/render/.gitignore
